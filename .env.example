# Copy this file to .env. These values are safe development defaults only.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://genegarden:genegarden@localhost:5432/genegarden
POSTGRES_DB=genegarden
POSTGRES_USER=genegarden
POSTGRES_PASSWORD=genegarden
POSTGRES_HOST_PORT=5432
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
OPEN_TARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql
EUROPE_PMC_API_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EXTERNAL_REQUEST_TIMEOUT_SECONDS=15
EXTERNAL_REQUEST_MAX_ATTEMPTS=3
EXTERNAL_REQUEST_BACKOFF_SECONDS=0.25
EXTERNAL_CACHE_TTL_SECONDS=3600
EUROPE_PMC_EMAIL=
# The core product uses deterministic evidence summaries. Optional LLM adapters are disabled.
ASSISTANT_LLM_PROVIDER=none
VITE_API_BASE_URL=http://localhost:8000/api/v1
API_HOST_PORT=8000
WEB_HOST_PORT=5173
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.0
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5
